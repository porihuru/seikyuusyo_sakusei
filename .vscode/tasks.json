{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ローカルWebサーバーを起動",
            "type": "process",
            "command": "node",
            "args": ["${workspaceFolder}/.vscode/server.cjs"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "local-server",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^ERROR (\\.vscode/server\\.cjs): (.*)$",
                    "kind": "file",
                    "file": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting local server",
                    "endsPattern": "^Local server ready:"
                }
            },
            "presentation": { "reveal": "silent", "panel": "dedicated" },
            "runOptions": { "instanceLimit": 1 }
        }
    ]
}
